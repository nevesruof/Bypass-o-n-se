---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/services.css';
---

<BaseLayout title="wArcxs Services" description="Minecraft client systems, modules, configs, builds and compatibility testing." bodyClass="day">
  <div class="os">
    <nav class="os-nav">
      <div class="os-nav-in">
        <div class="nav-section-label" aria-label="Services section">Services</div>
        <ul class="nav-side">
          <li><a href="#solutions">systems</a></li>
          <li><a href="#process">testing</a></li>
          <li><a href="#projects">projects</a></li>
          <li><a href="#contact">contact</a></li>
        </ul>
      </div>
    </nav>

    <header class="os-hero">
      <div class="hero-content">
        <h1>Client systems that adapt to the environment,<br>not the other way around.</h1>
        <p class="hero-lede">Minecraft versions, server behavior and anticheats change constantly.<br>
        <span class="uline">We account for it.</span> Modules, configs and compatibility systems,<br>
        engineered around real build conditions.</p>
      </div>
    </header>

    <section id="solutions" class="os-sec">
      <h2 class="mono-head" data-reveal="wipe">client systems</h2>

      <div class="sols-split">
        <div class="sols-left">
          <div class="sols-trigger" data-sols-trigger="0">
            <h3 class="sols-aud">For your Client</h3>
          </div>
          <div class="sols-trigger" data-sols-trigger="1">
            <h3 class="sols-aud">For Compatibility</h3>
          </div>
          <div class="sols-trigger" data-sols-trigger="2">
            <h3 class="sols-aud">For your Builds</h3>
          </div>
        </div>
        <div class="sols-right">
          <div class="sols-sticky-pane">
            <div class="sols-panel active" data-sols-panel="0">
              <div class="sols-panel-inner">
                <h3 class="sols-mobile-aud">For your Client</h3>
                <p class="sols-who">The build players actually run.</p>
                <p class="sols-ess">A modular client, built to stay <span class="uline">configurable</span> — never hard-coded.</p>
                <p class="sols-p">We structure the client around independent modules, configs, profiles and clean build states. ClickGUI, keybinds and version layers stay separated so behavior can be tuned without rebuilding the entire setup every time Minecraft changes.</p>
                <ul class="sols-deliver-list">
                  <li>Module systems</li>
                  <li>Configs & profiles</li>
                  <li>ClickGUI & HUD</li>
                </ul>
              </div>
            </div>
            <div class="sols-panel" data-sols-panel="1">
              <div class="sols-panel-inner">
                <h3 class="sols-mobile-aud">For Compatibility</h3>
                <p class="sols-who">The server-side environment around it.</p>
                <p class="sols-ess">Compatibility work built around <span class="uline">checks and flags</span>.</p>
                <p class="sols-p">We evaluate check behavior, flags, setbacks and version differences across controlled test environments. Prediction, latency, rotation and velocity are treated as measurable states — not as a permanent “undetected” promise.</p>
                <ul class="sols-deliver-list">
                  <li>Check & flag analysis</li>
                  <li>Version testing</li>
                  <li>Regression profiles</li>
                </ul>
              </div>
            </div>
            <div class="sols-panel" data-sols-panel="2">
              <div class="sols-panel-inner">
                <h3 class="sols-mobile-aud">For your Builds</h3>
                <p class="sols-who">The release pipeline behind the client.</p>
                <p class="sols-ess">Builds that stay organized as <span class="uline">versions move</span>.</p>
                <p class="sols-p">Stable, testing and experimental builds need clear status, changelogs and repeatable configs. We connect release tooling, access control and version notes so every build has a known state instead of becoming another unnamed jar.</p>
                <ul class="sols-deliver-list">
                  <li>Build channels</li>
                  <li>Status & changelogs</li>
                  <li>Licensing & integrity</li>
                  <li>Release automation</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="process" class="os-sec">
      <h2 class="mono-head" data-reveal="wipe">how we test</h2>

      <div class="how-grid" data-reveal="up">
        <div class="how-step">
          <h3 class="how-t">observe</h3>
          <p class="how-d">We start from the Minecraft version, target environment and expected behavior — then identify the checks, flags and edge cases that actually shape the build.</p>
        </div>
        <div class="how-step">
          <h3 class="how-t">configure</h3>
          <p class="how-d">Modules stay isolated, settings stay readable, and profiles are built around specific environments instead of one universal preset.</p>
        </div>
        <div class="how-step">
          <h3 class="how-t">test</h3>
          <p class="how-d">Builds are tested for regressions, version differences, latency-sensitive behavior and unexpected flags before a status is assigned.</p>
        </div>
        <div class="how-step">
          <h3 class="how-t">refine</h3>
          <p class="how-d">We ship, collect what changed, update the changelog and refine configs as server-side behavior and Minecraft versions move.</p>
        </div>
      </div>
    </section>

    <section id="projects" class="os-sec">
      <h2 class="mono-head" data-reveal="wipe">projects</h2>

      <div class="pc" data-reveal="up">
        <div class="pc-viewport">
          <div class="pc-track pc-track-single">
            <div class="pc-slide">
              <div class="pc-frame pc-maint" aria-label="Projects are in maintenance">
                <div class="pc-maint-copy">In maintenance...</div>
              </div>
            </div>
          </div>
        </div>
        <div class="pc-bar">
          <div class="pc-meta">
            <div class="pc-meta-item on" data-meta="0">
              <span class="pc-name">Projects</span>
              <span class="pc-tags">Portfolio previews are temporarily unavailable while this section is being refreshed.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section id="manifesto" class="os-sec mani-sec">
      <p class="mani-eyebrow" data-reveal="up">manifesto</p>
      <p class="mani-lead" data-reveal="up">wArcxs builds Minecraft client systems <span class="uline">with a point of view</span>.</p>
      <p class="mani-body" data-reveal="up">Modules, configs, builds and compatibility all belong to the same system. We design the interface and engineer the release stack with the same level of control.</p>
      <p class="mani-closer" data-reveal="up">Fewer builds. Deeper testing. Clearer status.</p>
    </section>

    <section id="contact" class="os-sec contact-sec">
      <h2 class="mono-head" data-reveal="wipe">contact</h2>

      <div class="contact-wrap">
        <a href="mailto:hello@warcxs.com" class="huge-email" data-reveal="up">hello@warcxs.com</a>
        <p class="loc-text" data-reveal="up">Spain based &mdash; available worldwide.</p>
      </div>
    </section>

    <footer class="os-foot">
      <span>2026 wArcxs &mdash; &copy; All rights reserved</span>
      <a href="/about" class="foot-about">About</a>
    </footer>
  </div>

  <script type="module">
    function initServices() {
      let e = document.querySelector('.os');
      if (!e || e.dataset.svcInit) return;
      e.dataset.svcInit = '1';

      let t = Array.from(document.querySelectorAll('[data-reveal]'));
      if (!t.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let n = el => el.classList.add('in'),
          r = el => {
            let rect = el.getBoundingClientRect();
            return rect.top < window.innerHeight * 0.94 && rect.bottom > 0;
          };

      t.forEach(el => el.classList.add('arm'));
      let i = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            n(entry.target);
            i.unobserve(entry.target);
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });

      t.forEach(el => i.observe(el));
      let a = () => {
        t.forEach(el => {
          if (!el.classList.contains('in') && r(el)) n(el);
        });
        if (t.every(el => el.classList.contains('in'))) window.removeEventListener('scroll', a);
      };
      window.setTimeout(a, 900);
      window.addEventListener('scroll', a, { passive: true });


      let triggers = Array.from(document.querySelectorAll('[data-sols-trigger]')),
          panels = Array.from(document.querySelectorAll('[data-sols-panel]'));
      if (triggers.length && 'IntersectionObserver' in window && !window.matchMedia('(max-width: 760px)').matches) {
        let obs = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              let idxAttr = entry.target.getAttribute('data-sols-trigger');
              triggers.forEach(tr => tr.classList.remove('is-active'));
              panels.forEach(p => p.classList.remove('active'));
              entry.target.classList.add('is-active');
              if (idxAttr !== null && panels[Number(idxAttr)]) {
                panels[Number(idxAttr)].classList.add('active');
              }
            }
          });
        }, { rootMargin: '-40% 0px -40% 0px' });

        triggers.forEach(tr => obs.observe(tr));
        if (triggers[0]) triggers[0].classList.add('is-active');
      }
    }
    initServices();
    document.addEventListener('astro:page-load', initServices);
  </script>
</BaseLayout>
