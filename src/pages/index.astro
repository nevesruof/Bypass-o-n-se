---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/hub.css';
---

<BaseLayout title="wArcxs" description="wArcxs — Minecraft client engineering, modules, configs, builds and compatibility systems." bodyClass="hubpage">
  <div class="head">
    <div class="wm wm-static-home" aria-label="wArcxs logo"><img class="wmlogo wmlogo-home" src="/brand/warcxs-logo-black.png" alt="wArcxs" draggable="false"></div>
    <p class="tag">We engineer Minecraft client systems — modules, configs, builds and compatibility tooling.</p>
  </div>

  <div class="doors" id="doors">
    <a class="door products" href="/products">
      <span class="kicker">Client</span>
      <h2>We configure.</h2>
      <p>Modular systems, profiles and build tooling designed around control, consistency and clean releases.</p>
      <span class="enter">Enter</span>
    </a>
    <a class="door services" href="/services">
      <span class="kicker">Compatibility</span>
      <h2>We test.</h2>
      <p>Checks, flags, prediction, latency and version-focused testing for modern Minecraft environments.</p>
      <span class="enter">Enter</span>
    </a>
  </div>

  <script type="module">
    function initDoors() {
      let e = document.getElementById('doors');
      if (!e || e.dataset.drift || !matchMedia('(hover:hover) and (min-width:721px)').matches) return;
      e.dataset.drift = '1';
      let t = 0;
      e.addEventListener('pointermove', n => {
        let r = e.getBoundingClientRect(), i = Math.min(1, Math.max(0, (n.clientX - r.left) / r.width));
        cancelAnimationFrame(t), t = requestAnimationFrame(() => e.style.setProperty('--p', i.toFixed(3)));
      });
      e.addEventListener('pointerleave', () => e.style.setProperty('--p', '.5'));
    }
    initDoors();
    document.addEventListener('astro:page-load', initDoors);
  </script>

  <footer class="hub">
    <div class="in">
      <p>wArcxs focuses on client architecture, compatibility, and how every build behaves from first config to final release. <a href="/about" class="al">Learn more <span class="arw" aria-hidden="true">&rarr;</span></a></p>
      <p class="fine">2026 wArcxs &mdash; &copy; All rights reserved</p>
    </div>
  </footer>
</BaseLayout>
