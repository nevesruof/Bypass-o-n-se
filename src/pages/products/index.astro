---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/products.css';
---

<BaseLayout title="wArcxs — Products" description="wArcxs products for client builds: Java protection and hosted licensing. Pick the layer you need.">
  <div class="pchoose">
    <header class="pc-top">
      <div class="pc-wm-static" aria-label="wArcxs logo"><img src="/brand/warcxs-logo-orange.png" alt="wArcxs" draggable="false"></div>
      <a class="pc-back" href="/">← Home</a>
    </header>

    <main class="pc-main">
      <div class="pc-head">
        <h1>Two systems. <em>One release stack.</em></h1>
        <p>Protect the build, control access, and keep every release easier to manage.</p>
      </div>

      <div class="pc-grid">
        <a class="pc-card" href="/products/lockmaster">
          <span class="pc-kicker">Build</span>
          <h2>Lock Master</h2>
          <p>Java build protection for clients, launchers and tools — hardened bytecode, sealed classes and traceable releases.</p>
          <span class="pc-enter">Enter <span class="arw">→</span></span>
        </a>
        <a class="pc-card" href="/products/licenses">
          <span class="pc-kicker">Access</span>
          <h2>Licenses</h2>
          <p>Hosted licensing for client builds — signed validation, tiers, feature flags and controlled access from one system.</p>
          <span class="pc-enter">Enter <span class="arw">→</span></span>
        </a>
      </div>
    </main>

    <footer class="pc-foot">
      <span>2026 wArcxs &mdash; &copy; All rights reserved</span>
      <nav><a href="/legal/terms">Terms</a><a href="/legal/privacy">Privacy</a></nav>
    </footer>
  </div>
</BaseLayout>
