  <script type="module">
    function initLockmaster() {
      let e = document.querySelector('.os-nav');
      if (e && e.dataset.init) return;
      if (e) e.dataset.init = '1';

      let t = Array.from(document.querySelectorAll('[data-feat]'));
      if (t.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let addIn = el => el.classList.add('in'),
            isVis = el => {
              let rect = el.getBoundingClientRect();
              return rect.top < window.innerHeight * 0.92 && rect.bottom > 0;
            };

        t.forEach(el => el.classList.add('arm'));
        let r = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              addIn(entry.target);
              r.unobserve(entry.target);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });

        t.forEach(el => r.observe(el));
        let i = () => {
          t.forEach(el => {
            if (!el.classList.contains('in') && isVis(el)) addIn(el);
          });
          if (t.every(el => el.classList.contains('in'))) window.removeEventListener('scroll', i);
        };
        window.setTimeout(i, 900);
        window.addEventListener('scroll', i, { passive: true });
      }

      let n = document.querySelector('[data-files]');
      if (n) {
        let tabs = n.querySelectorAll('.cz-tab'),
            panels = n.querySelectorAll('.cz-panel'),
            reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        tabs.forEach(tab => tab.addEventListener('click', () => {
          let idx = Number(tab.getAttribute('data-i'));
          tabs.forEach(t => t.classList.toggle('on', t === tab));
          panels.forEach(p => {
            let isTarget = Number(p.getAttribute('data-i')) === idx;
            p.classList.toggle('on', isTarget);
            if (isTarget && !reducedMotion) {
              p.classList.remove('seal');
              p.offsetWidth;
              p.classList.add('seal');
            }
          });
        }));
      }
    }
    initLockmaster();
    document.addEventListener('astro:page-load', initLockmaster);
  </script>
