    <header class="os-nav">
      <nav class="os-nav-in">
        <a class="nav-logo" href="/products/lockmaster" aria-label="wArcxs — home"><span class="os-brand">wArcxs</span> <span class="os-mark" style="margin: 0;">Lock Master</span></a>
        <ul class="nav-side">
          <li><a href="#engine">features</a></li>
          <li><a href="#code">the code</a></li>
          <li><a href="https://warcxs.com/discord" target="_blank" rel="noopener">community</a></li>
